# ---------------------------------------------------------------
# RS-Auto-Org_Chart-Generator — environment variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ---------------------------------------------------------------

# JWT session signing key — REQUIRED in production.
# Generate with: openssl rand -base64 32
# Falls back to a hardcoded dev key when unset (unsafe for production).
SESSION_SECRET=

# (Optional) Override the default port (3000).
# PORT=3000

# Employee Portal directory (read-only). People, departments, reporting lines and
# photos come from the portal's Supabase Postgres `directory` views — REQUIRED.
# Uses the directory_reader login through the Supabase pooler (transaction mode, port 6543).
# URL-encode special characters in the password.
DIRECTORY_DATABASE_URL=postgresql://directory_reader.<project-ref>:<password>@<pooler-host>:6543/postgres
# (Optional) Supabase project URL for photos. Derived from the username above when unset.
# DIRECTORY_SUPABASE_URL=https://<project-ref>.supabase.co

# API key for external integrations (n8n, AI agents).
# When set, requests with header "X-API-Key: <value>" get editor-level access
# to the API endpoints.
# Generate with: openssl rand -base64 32
API_KEY=replace-with-generated-api-key

# Optional browser-facing origin used for generated public onboarding links.
# Set this when a reverse proxy forwards requests with an internal service host.
PUBLIC_APP_ORIGIN=https://tools.romega-solutions.com

# Optional weekly live QA / automation targets.
ORGCHART_BASE_URL=https://tools.romega-solutions.com/org-chart
ORGCHART_API_KEY=replace-with-generated-api-key
ORGCHART_MCP_URL=https://n8n-romega-n8n.ikuuwb.easypanel.host/mcp/rs-org-chart

# Internal tools readiness dashboard targets.
# Used by /admin/tools and /api/tools/status.
INTERNAL_TOOL_ORG_CHART_URL=http://localhost:3000/org-chart
INTERNAL_TOOL_CERTIFICATE_URL=http://localhost:3001
INTERNAL_TOOL_EMAIL_SIGNATURE_URL=http://localhost:4321
INTERNAL_TOOL_JOB_SCRAPER_URL=http://localhost:5555
INTERNAL_TOOL_API_KEY=replace-with-generated-api-key

# ATS portal handoff contract. The current JWT login remains active until the
# server-side /api/auth/handoff exchange endpoint is implemented and enabled.
ATS_PORTAL_URL=https://rs-tool-ats.vercel.app/internal-tools
ATS_SSO_ISSUER_URL=https://rs-tool-ats.vercel.app
ATS_SSO_AUDIENCE=org_chart
ATS_SSO_EXCHANGE_SECRET=replace-with-generated-handoff-secret

# Optional durable n8n Data Table storage for serverless deployments.
# The uploaded logo can persist in n8n instead of the local filesystem.
# The SQLite snapshot table keeps login accounts and settings across cold starts.
N8N_URL=https://n8n.example.com
N8N_API_KEY=replace-with-n8n-api-key
N8N_ORG_CHART_PHOTO_TABLE_ID=90OAp9D151SLv9ht
N8N_ORG_CHART_DB_SNAPSHOT_TABLE_ID=sSFhGsZShnwyVylu
