      "id": "ec7a9469-1e97-42d0-a96f-e37d363aa7e0",
      "name": "Fetch Current Org Chart",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        640
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "function parseCsvLine(line) {\n  const values = [];\n  let current = '';\n  let inQuotes = false;\n\n  for (let i = 0; i < line.length; i++) {\n    const char = line[i];\n    const next = line[i + 1];\n\n    if (char === '\"' && inQuotes && next === '\"') {\n      current += '\"';\n      i++;\n    } else if (char === '\"') {\n      inQuotes = !inQuotes;\n    } else if (char === ',' && !inQuotes) {\n      values.push(current.trim());\n      current = '';\n    } else {\n      current += char;\n    }\n  }\n\n  values.push(current.trim());\n  return values;\n}\n\nfunction normalize(value) {\n  return String(value || '').trim().toLowerCase();\n}\n\nconst sheetItem = $('Fetch Google Sheet CSV').first();\nconst csvText = sheetItem.json.data || sheetItem.json.body || '';\nconst lines = csvText.trim().split(/\\r?\\n/).filter(Boolean);\nconst header = parseCsvLine(lines[0] || '').map(normalize);\n\nfunction column(...names) {\n  for (const name of names) {\n    const idx = header.indexOf(normalize(name));\n    if (idx >= 0) return idx;\n  }\n  return -1;\n}\n\nconst nameIdx = column('Name');\nconst titleIdx = column('Role/Position', 'Role', 'Position', 'Title');\nconst teamIdx = column('Team', 'Department');\nconst emailIdx = column('Work Email', 'Email');\n\nconst sheetPeople = [];\nfor (let i = 1; i < lines.length; i++) {\n  const values = parseCsvLine(lines[i]);\n  const name = values[nameIdx] || '';\n  if (!name) continue;\n  sheetPeople.push({\n    name,\n    title: titleIdx >= 0 ? values[titleIdx] : '',\n    team: teamIdx >= 0 ? values[teamIdx] : '',\n    email: emailIdx >= 0 ? values[emailIdx] : ''\n  });\n}\n\nconst orgItem = $('Fetch Current Org Chart').first();\nlet orgPeople = [];\nif (Array.isArray(orgItem.json)) {\n  orgPeople = orgItem.json;\n} else if (Array.isArray(orgItem.json.data)) {\n  orgPeople = orgItem.json.data;\n} else if (Array.isArray(orgItem.json.body)) {\n  orgPeople = orgItem.json.body;\n} else {\n  orgPeople = Object.values(orgItem.json).find((value) => Array.isArray(value)) || [];\n}\n\nconst orgActive = orgPeople.filter((person) => person.isActive !== false && person.isActive !== 0);\nconst orgNames = new Set(orgActive.map((person) => normalize(person.name)));\nconst sheetNames = new Set(sheetPeople.map((person) => normalize(person.name)));\n\nconst newHires = sheetPeople.filter((person) => !orgNames.has(normalize(person.name)));\nconst departures = orgActive.filter((person) => !sheetNames.has(normalize(person.name)) && normalize(person.name) !== 'robbie galoso');\n\nconst titleChanges = [];\nfor (const sheetPerson of sheetPeople) {\n  const match = orgActive.find((orgPerson) => normalize(orgPerson.name) === normalize(sheetPerson.name));\n  if (match && normalize(match.title) !== normalize(sheetPerson.title)) {\n    titleChanges.push({\n      name: sheetPerson.name,\n      oldTitle: match.title,\n      newTitle: sheetPerson.title\n    });\n  }\n}\n\nconst totalChanges = newHires.length + departures.length + titleChanges.length;\nlet summary = `Org Chart Sync Report - ${new Date().toLocaleDateString()}\\n`;\nsummary += `=======================================\\n\\n`;\nsummary += `Sheet people: ${sheetPeople.length}\\n`;\nsummary += `Active org chart people: ${orgActive.length}\\n\\n`;\n\nif (totalChanges === 0) {\n  summary += 'No changes detected. Org chart is up to date.';\n} else {\n  summary += `${totalChanges} change(s) detected:\\n\\n`;\n\n  if (newHires.length) {\n    summary += `NEW HIRES (${newHires.length}):\\n`;\n    newHires.forEach((person) => summary += `  + ${person.name} - ${person.title} (${person.team})\\n`);\n    summary += '\\n';\n  }\n\n  if (departures.length) {\n    summary += `DEPARTURES (${departures.length}):\\n`;\n    departures.forEach((person) => summary += `  - ${person.name} - ${person.title} (${person.departmentName || person.department || '?'})\\n`);\n    summary += '\\n';\n  }\n\n  if (titleChanges.length) {\n    summary += `TITLE/ROLE CHANGES (${titleChanges.length}):\\n`;\n    titleChanges.forEach((change) => summary += `  ~ ${change.name}: \"${change.oldTitle}\" -> \"${change.newTitle}\"\\n`);\n    summary += '\\n';\n  }\n}\n\nreturn [{\n  json: {\n    totalChanges,\n    summary,\n    newHiresCount: newHires.length,\n    departuresCount: departures.length,\n    titleChangesCount: titleChanges.length,\n    sheetPeopleCount: sheetPeople.length,\n    orgPeopleActiveCount: orgActive.length\n  }\n}];"
      },
      "id": "7b9843ac-eb99-426b-80ad-ff369731465b",
      "name": "Compare Sheet vs Org Chart",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        640
      ]
