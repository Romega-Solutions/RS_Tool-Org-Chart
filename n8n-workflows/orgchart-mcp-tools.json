{
  "name": "RS Org Chart MCP Tools (read-only)",
  "nodes": [
    {
      "parameters": {
        "path": "rs-org-chart"
      },
      "id": "7a933a4c-fb0c-4fa1-a70c-4ea9a6a21611",
      "name": "MCP Server Trigger",
      "type": "@n8n/n8n-nodes-langchain.mcpTrigger",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "rs-org-chart"
    },
    {
      "parameters": {
        "content": "## RS Org Chart MCP Tools (read-only)\n\nThis workflow is designed to run inside the Romega Easypanel n8n container.\n\nBrowser/public app URL:\nhttps://tools.romega-solutions.com/org-chart\n\nInternal n8n-to-org-chart API base:\nhttp://romega-projects_rs_tool-org-chart:80/org-chart\n\nSet this n8n environment variable before activating:\n\nORGCHART_API_KEY=<your API key>\n\nThe org chart is a read-only view of the Employee Portal. People, departments and reporting lines are edited in the portal's User Management, so this workflow only exposes read tools.\n\nActivate the workflow, then copy the production MCP URL from the MCP Server Trigger node."
      },
      "id": "eb706d99-6f82-46e9-9c37-91cae57652ac",
      "name": "Setup Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -340,
        -220
      ]
    },
    {
      "parameters": {
        "url": "http://romega-projects_rs_tool-org-chart:80/org-chart/api/people/headless?includeInactive=true",
        "sendHeaders": true,
        "toolDescription": "List all staff (id, name, title, email, department, managerId, isActive), including inactive people. Read-only: people are edited in the Employee Portal, not here.",
        "parametersHeaders": {
          "values": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ORGCHART_API_KEY }}",
              "valueProvider": "fieldValue"
            }
          ]
        }
      },
      "id": "362df8a3-00d2-41cb-8188-d609f6b5f3a2",
      "name": "list_people",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        -420,
        260
      ]
    },
    {
      "parameters": {
        "url": "http://romega-projects_rs_tool-org-chart:80/org-chart/api/chart-data",
        "sendHeaders": true,
        "toolDescription": "Get the rendered org chart tree, departments, and settings for read-only analysis.",
        "parametersHeaders": {
          "values": [
            {
              "name": "X-API-Key",
              "value": "={{ $env.ORGCHART_API_KEY }}",
              "valueProvider": "fieldValue"
            }
          ]
        }
      },
      "id": "45c0291f-3139-4f51-8971-f2118af30bc0",
      "name": "get_chart_data",
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "position": [
        -180,
        260
      ]
    }
  ],
  "connections": {
